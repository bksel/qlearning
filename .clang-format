# clang-format configuration for modern C++20
# Based on LLVM with custom overrides
BasedOnStyle: LLVM

# --- Core Format & Language ---
Language: Cpp
Standard: Latest
ColumnLimit: 100
TabWidth: 4
IndentWidth: 4
UseTab: Never

# --- Indentation & Spacing ---
AccessModifierOffset: -4
NamespaceIndentation: None
ContinuationIndentWidth: 2

# --- Alignment ---
# Consecutive alignments set to false to avoid massive Git diffs
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: true
AlignEscapedNewlines: Left
AlignOperands: Align
AlignTrailingComments: true

# --- Pointers & References ---
PointerAlignment: Left
ReferenceAlignment: Pointer

# --- Braces & Blocks ---
AllowAllArgumentsOnNextLine: false
BreakBeforeBraces: WebKit
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: true
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true

# --- Constructor Initializers ---
PackConstructorInitializers: Never
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 2

# --- C++20 Specifics ---
RequiresClausePosition: OwnLine
RequiresExpressionIndentation: Keyword

# --- Line Breaks ---
BreakAfterReturnType: All
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: false
PenaltyReturnTypeOnItsOwnLine: 0

AlignAfterOpenBracket: BlockIndent
BinPackParameters: AlwaysOnePerLine
PenaltyBreakBeforeFirstCallParameter: 0  # <-- Lowered to 0 to remove the penalty for breaking early

# --- Miscellaneous ---
MaxEmptyLinesToKeep: 1
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpacesInAngles: Never
SpacesInContainerLiterals: false